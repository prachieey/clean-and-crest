# ==============================================================================
# Clean & Crest — Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development or set these variables
# directly in your hosting platform (Vercel, Cloudflare, Netlify, Railway, etc.).
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & SEO CONFIGURATION
# ------------------------------------------------------------------------------
# The canonical base URL used for email assets, sitemap.xml, robots.txt, and metadata.
# Do not include trailing slashes.
APP_BASE_URL=https://cleanandcrest.au
NEXT_PUBLIC_SITE_URL=https://cleanandcrest.au

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL SYSTEM (Provider-Agnostic)
# ------------------------------------------------------------------------------
# Provider switcher: "resend" (recommended) | "sendgrid" | "smtp"
EMAIL_PROVIDER=resend

# Unified API Key (or use RESEND_API_KEY / SENDGRID_API_KEY)
EMAIL_API_KEY=re_1234567890abcdef
RESEND_API_KEY=re_1234567890abcdef

# Verified sender address (must use a verified domain, e.g. cleanandcrest.au)
# In development before domain verification, can use: "Clean & Crest <onboarding@resend.dev>"
EMAIL_FROM="Clean & Crest <bookings@cleanandcrest.au>"

# Business inbox where customer replies to confirmations should be sent
EMAIL_REPLY_TO=cleanandcrest@gmail.com

# Internal email address where new booking/quote notifications are delivered
BUSINESS_NOTIFY_EMAIL=cleanandcrest@gmail.com
QUOTE_RECIPIENT_EMAIL=cleanandcrest@gmail.com
CONTACT_RECIPIENT_EMAIL=cleanandcrest@gmail.com

# Option B: SendGrid Configuration
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.1234567890abcdef

# Option C: Standard SMTP Configuration
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@cleanandcrest.au
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS LEAD SYNC (Google Apps Script Webhook)
# ------------------------------------------------------------------------------
# Deployed Apps Script Webhook URL (must have access set to "Anyone")
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
