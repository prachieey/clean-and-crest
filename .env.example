# ==============================================================================
# Clean & Crest — Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development or set these variables
# directly in your hosting platform (Vercel, Cloudflare, Netlify, Railway, etc.).
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & SEO CONFIGURATION
# ------------------------------------------------------------------------------
# The canonical base URL used for sitemap.xml, robots.txt, Open Graph, and JSON-LD.
# Do not include trailing slashes.
NEXT_PUBLIC_SITE_URL=https://cleanandcrest.com.au

# ------------------------------------------------------------------------------
# 2. LEAD NOTIFICATION & EMAIL DISPATCH
# ------------------------------------------------------------------------------
# Primary destination email addresses where lead enquiries are routed.
QUOTE_RECIPIENT_EMAIL=quotes@cleanandcrest.com.au
CONTACT_RECIPIENT_EMAIL=info@cleanandcrest.com.au

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL PROVIDER (Choose one provider)
# ------------------------------------------------------------------------------
# Option A: Resend (Recommended for Next.js / Serverless)
RESEND_API_KEY=re_1234567890abcdef

# Option B: SendGrid
# SENDGRID_API_KEY=SG.1234567890abcdef

# Option C: Standard SMTP
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@cleanandcrest.com.au
# SMTP_PASS=your-smtp-password
